{
  "games": [
    {
      "id": "minecraft-paper",
      "name": "Minecraft",
      "subtitle": "Paper 1.20.4",
      "icon": "minecraft.png",
      "requires": ["java21"],
      "install": {
        "type": "direct-download",
        "steps": [
          "cd /home/gameserver/instances/{instance_id} && URL=$(curl -s https://fill.papermc.io/v3/projects/paper/versions/1.20.4/builds | jq -r '.[0].downloads[\"server:default\"].url') && curl -o paper.jar \"$URL\"",
          "cd /home/gameserver/instances/{instance_id} && echo 'eula=true' > eula.txt"
        ]
      },
      "start_command": "java -Xmx{ram_limit_mb}M -Xms1024M -jar paper.jar nogui",
      "default_cpu_limit_percent": 200,
      "default_ram_limit_mb": 4096
    },
    {
      "id": "palworld",
      "name": "Palworld",
      "subtitle": "v0.2.1.0",
      "icon": "palworld.png",
      "requires": ["steamcmd"],
      "install": {
        "type": "steamcmd",
        "app_id": 2394010,
        "steps": [
          "mkdir -p /home/gameserver/instances/{instance_id}",
          "steamcmd +force_install_dir /home/gameserver/instances/{instance_id} +login anonymous +app_update 2394010 validate +quit"
        ]
      },
      "start_command": "./PalServer.sh -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS",
      "default_cpu_limit_percent": 200,
      "default_ram_limit_mb": 8192
    }
  ]
}
